:root {
    background-image: url("project://database/Assets/Images/MenuBackground.png?fileID=2800000&guid=7c7e4ffc0083d7442afb3b028705c0eb&type=3#MenuBackground");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(128, 128, 128);
}

#title {
    font-size: 64px;
    flex-direction: row;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    justify-content: center;
    -unity-text-align: middle-center;
    height: 50%;
    color: rgb(255, 212, 41);
}
