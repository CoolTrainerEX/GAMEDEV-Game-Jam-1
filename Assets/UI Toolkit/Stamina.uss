#StaminaBar {
    position: absolute;
    bottom: 30px;           
    left: 50%;             
    translate: -50% 0;     
    width: 300px;
    height: 24px;
}

#StaminaBar .unity-progress-bar__background {
    background-color: rgba(15, 15, 15, 0.85);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    overflow: hidden;
}

#StaminaBar .unity-progress-bar__progress {
    background-color: rgb(46, 204, 113);
    border-radius: 6px;
    margin: 0;
    transition-property: width;
    transition-duration: 0.05s;
}